Options -MultiViews -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Dossiers internes jamais accessibles depuis le navigateur
RewriteRule ^(sql|db|config|includes)(/|$) - [F,L]

# Photo absente du disque (après redéploiement) : servie depuis la base
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^uploads/photos/([A-Za-z0-9._-]+)$ photo.php?f=$1 [L,QSA]

# Lien court /l/CODE
RewriteRule ^l/([A-Za-z0-9]{4,20})/?$ l.php?c=$1 [L,QSA]

# /page.php -> /page (URL propre)
RewriteCond %{THE_REQUEST} ^[A-Z]+\s(\S*?)\.php(\?\S*)?\sHTTP/ [NC]
RewriteRule ^ %1%2 [R=301,L,NE]

# /page -> page.php (en interne)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json application/wasm
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 30 days"
ExpiresByType application/javascript "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType application/wasm "access plus 365 days"
ExpiresByType font/woff2 "access plus 365 days"
</IfModule>
